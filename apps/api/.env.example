# Copie para .env (ignorado pelo git). O docker-compose da raiz já define estes valores.
PANDORA_DB_URL=postgresql://pandora:pandora_local@localhost:5434/pandora
PANDORA_SESSAO_HORAS=168
PANDORA_ORIGENS_CORS=http://localhost:3000
# Serviço do RAG (`uv run pandora-rag servir`, em services/rag). No Docker, use http://host.docker.internal:8010.
PANDORA_RAG_URL=http://localhost:8010
